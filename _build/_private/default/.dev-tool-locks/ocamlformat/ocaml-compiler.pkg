(version 5.5.2)

(install
 (withenv
  ((= MSYS2_ARG_CONV_EXCL *)
   (= LSAN_OPTIONS detect_leaks=0,exitcode=0)
   (= ASAN_OPTIONS detect_leaks=0,exitcode=0))
  (run
   sh
   tools/opam/process.sh
   %{make}
   install
   %{pkg-self:build-id}
   %{pkg-self:name}
   %{prefix})))

(build
 (withenv
  ((= MSYS2_ARG_CONV_EXCL *)
   (= LSAN_OPTIONS detect_leaks=0,exitcode=0)
   (= ASAN_OPTIONS detect_leaks=0,exitcode=0))
  (run
   sh
   tools/opam/process.sh
   %{make}
   -j%{jobs}
   %{pkg-self:build-id}
   %{pkg-self:name}
   %{pkg:compiler-cloning:version}
   (when false "")
   (when false "")
   --prefix=%{prefix}
   --docdir=%{doc}/ocaml
   --with-additional-stublibsdir
   --with-relative-libdir
   --enable-runtime-search
   --enable-runtime-search-target=fallback
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   (when false "")
   --disable-warn-error)))

(depends compiler-cloning)

(source
 (fetch
  (url
   https://github.com/ocaml/ocaml/releases/download/5.5.2/ocaml-5.5.2.tar.gz)
  (checksum
   sha256=bb3ffef5e4fce4f04915b9f254f570663311e1f227fd669aa87a5ef7de9a1523)))
